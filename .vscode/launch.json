{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "type": "java",
            "name": "Launch TrackingApplication",
            "request": "launch",
            "mainClass": "com.expense.tracking.TrackingApplication",
            "projectName": "tracking",
            "cwd": "${workspaceFolder}/tracking",
            "env": {
                "SPRING_PROFILES_ACTIVE": "dev"
            },
            "args": [],
            "vmArgs": [
                "-Dspring.devtools.restart.enabled=true",
                "-Dspring.devtools.livereload.enabled=true"
            ],
            "console": "internalConsole",
            "stopOnEntry": false,
            "serverReadyAction": {
                "pattern": "started on port ([0-9]+)",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        },
        {
            "type": "java",
            "name": "Debug TrackingApplication",
            "request": "launch",
            "mainClass": "com.expense.tracking.TrackingApplication",
            "projectName": "tracking",
            "cwd": "${workspaceFolder}/tracking",
            "env": {
                "SPRING_PROFILES_ACTIVE": "dev"
            },
            "args": [],
            "vmArgs": [
                "-Dspring.devtools.restart.enabled=true",
                "-Dspring.devtools.livereload.enabled=true",
                "-Xdebug",
                "-Xrunjdwp:transport=dt_socket,server=y,suspend=n,address=5005"
            ],
            "console": "internalConsole",
            "stopOnEntry": false,
            "serverReadyAction": {
                "pattern": "started on port ([0-9]+)",
                "uriFormat": "http://localhost:%s",
                "action": "openExternally"
            }
        },
        {
            "type": "java",
            "name": "Launch Tests",
            "request": "launch",
            "mainClass": "",
            "projectName": "tracking",
            "cwd": "${workspaceFolder}/tracking",
            "classPaths": [
                "${workspaceFolder}/tracking/build/classes/java/test",
                "${workspaceFolder}/tracking/build/classes/java/main"
            ],
            "modulePaths": [],
            "args": [],
            "vmArgs": [
                "-Dspring.profiles.active=test"
            ],
            "console": "internalConsole",
            "stopOnEntry": false
        },
        {
            "type": "java",
            "name": "Attach to Remote JVM",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005,
            "projectName": "tracking"
        }
    ]
}